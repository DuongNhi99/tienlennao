# Copy to .env and adjust. Never commit real credentials.
# A single root .env is read by the server (apps/server), the web app (apps/web),
# Prisma CLI scripts, docker compose, and scripts/embedded-postgres.mjs.

# ── Server (apps/server) ─────────────────────────────────────────────────────
PORT=4000
# Comma-separated browser origins allowed by CORS.
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://tienlen:tienlen_dev_password@localhost:5432/tienlen?schema=public
REDIS_URL=redis://localhost:6379
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse proxies in front of the API (0 = clients connect directly). Needed so
# per-IP rate limits see the real client address; never set it higher than the real count.
# TRUST_PROXY=1

# ── Accounts (apps/server) ───────────────────────────────────────────────────
# Public web URL used in email links (defaults to the first WEB_ORIGIN).
# WEB_APP_URL=https://tienlen.example
# Public API URL with /api/v1, used in avatar links (defaults to http://localhost:PORT/api/v1).
# API_PUBLIC_URL=https://api.tienlen.example/api/v1
# Sessions expire after this many idle days (and after 3× this in total).
SESSION_TTL_DAYS=30
# Set to the parent domain only when web and API run on sibling subdomains.
# COOKIE_DOMAIN=tienlen.example
# Virtual coins granted once at registration.
INITIAL_COIN_BONUS=10000
# Email delivery. Without SMTP_URL, development writes emails to MAIL_OUTBOX_DIR and
# production sends nothing (verification and password reset then cannot be completed).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Tiến Lên Online <no-reply@tienlen.example>
MAIL_OUTBOX_DIR=.local/mail
# Re-encoded avatar images. Must be shared storage when running several API instances.
UPLOAD_DIR=.local/uploads

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Base URL the browser uses to reach the API (inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional: base URL the Next.js server uses to reach the API (e.g. inside Docker).
# API_INTERNAL_URL=http://server:4000/api/v1
# DEVELOPMENT ONLY: skip sign-in and render lobby / waiting room / game table with
# in-browser mock data. Never set this in a deployed environment. Removed once Phase 5 lands.
NEXT_PUBLIC_UI_PREVIEW=false

# ── docker compose (local PostgreSQL / Redis) ────────────────────────────────
# Must match the credentials in DATABASE_URL above.
POSTGRES_USER=tienlen
POSTGRES_PASSWORD=tienlen_dev_password
POSTGRES_DB=tienlen

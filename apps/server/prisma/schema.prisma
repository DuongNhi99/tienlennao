// Tiến Lên Online — PostgreSQL schema.
//
// Conventions
// - Primary keys are UUIDs generated by the database layer (Prisma uuid()).
// - Coin amounts are integers (virtual points only; never floating point, never real money).
// - Wallet ledger rows (WalletTransaction) are append-only: the application never updates
//   or deletes them. Corrections are new ADMIN_ADJUSTMENT rows with a reason.
// - Users are soft-deleted (status = DELETED) so ledger, match, and audit history stay intact;
//   relations that must preserve history use onDelete: Restrict.
// - CHECK constraints that Prisma cannot express are added in migration SQL
//   (see migrations/*_init/migration.sql).
//
// Retention (defaults; enforce with scheduled jobs in a later phase)
// - Sessions and auth tokens: deleted 30 days after expiry/revocation.
// - Notifications: deleted 90 days after being read.
// - Chat messages: deleted 30 days after the room closes.
// - Matches, match events, ledger, audit logs: retained indefinitely.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ───────────────────────────────────────────────────────────────

enum UserRole {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  /// Normalized (trimmed, lower-cased) by the application before storage.
  email            String     @unique @db.VarChar(254)
  /// Argon2id hash. Null for accounts that only sign in with an OAuth provider.
  passwordHash     String?
  role             UserRole   @default(PLAYER)
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  suspendedAt      DateTime?
  suspensionReason String?    @db.VarChar(500)
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  profile                 UserProfile?
  oauthAccounts           OAuthAccount[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  wallet                  Wallet?
  walletTransactions      WalletTransaction[]      @relation("TransactionOwner")
  hostedRooms             Room[]                   @relation("RoomHost")
  roomSeat                RoomPlayer?
  matchmakingEntry        MatchmakingEntry?
  matchPlayers            MatchPlayer[]
  rewardClaims            RewardClaim[]
  achievements            UserAchievement[]
  notifications           Notification[]
  chatMessages            ChatMessage[]
  reportsFiled            PlayerReport[]           @relation("ReportReporter")
  reportsReceived         PlayerReport[]           @relation("ReportReported")
  reportsResolved         PlayerReport[]           @relation("ReportResolver")
  auditLogs               AdminAuditLog[]
  ruleConfigsCreated      GameRuleConfiguration[]
  adjustmentsMade         WalletTransaction[]      @relation("AdjustmentActor")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  userId        String   @id @db.Uuid
  displayName   String   @db.VarChar(32)
  avatarUrl     String?  @db.VarChar(512)
  locale        String   @default("vi") @db.VarChar(8)
  /// Denormalized counters updated inside the settlement transaction. Only FINISHED matches count.
  matchesPlayed Int      @default(0)
  matchesWon    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@map("user_profiles")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String   @db.VarChar(32)
  providerAccountId String   @db.VarChar(255)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Server-managed session. The browser holds an opaque random token in an HttpOnly cookie;
/// only its SHA-256 hash is stored here.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  userAgent  String?   @db.VarChar(512)
  ipAddress  String?   @db.VarChar(45)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Wallet & ledger ────────────────────────────────────────────────────────

enum WalletTransactionType {
  INITIAL_BONUS
  DAILY_REWARD
  MATCH_ENTRY
  MATCH_REWARD
  MATCH_REFUND
  ADMIN_ADJUSTMENT
  ACHIEVEMENT_REWARD
}

enum WalletTransactionStatus {
  COMPLETED
  FAILED
}

model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  /// CHECK (balance >= 0) is enforced in migration SQL.
  balance     Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  /// Incremented on every balance change; used for optimistic concurrency checks.
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@map("wallets")
}

/// Append-only ledger. `amount` is signed: positive = credit, negative = debit.
model WalletTransaction {
  id             String                  @id @default(uuid()) @db.Uuid
  walletId       String                  @db.Uuid
  userId         String                  @db.Uuid
  type           WalletTransactionType
  amount         Int
  balanceAfter   Int
  status         WalletTransactionStatus @default(COMPLETED)
  /// Unique per user, e.g. "match:<matchId>:entry" or "daily:2026-10-26".
  idempotencyKey String                  @db.VarChar(128)
  matchId        String?                 @db.Uuid
  /// Admin who created an ADMIN_ADJUSTMENT; null for system-generated rows.
  actorId        String?                 @db.Uuid
  reason         String?                 @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime                @default(now())

  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user        User         @relation("TransactionOwner", fields: [userId], references: [id], onDelete: Restrict)
  match       Match?       @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actor       User?        @relation("AdjustmentActor", fields: [actorId], references: [id], onDelete: Restrict)
  rewardClaim RewardClaim?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([matchId])
  @@index([type, createdAt])
  @@map("wallet_transactions")
}

// ─── Rooms & matches ────────────────────────────────────────────────────────
// Status enums must match ROOM_STATUSES / MATCH_STATUSES in @tienlen/shared (tested).

enum RoomStatus {
  WAITING
  READY
  STARTING
  IN_PROGRESS
  FINISHED
  CANCELLED
  EXPIRED
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

model Room {
  id               String         @id @default(uuid()) @db.Uuid
  /// Short human-friendly join code (unguessable room identity is the UUID `id`).
  code             String         @unique @db.VarChar(12)
  name             String?        @db.VarChar(48)
  hostId           String         @db.Uuid
  visibility       RoomVisibility @default(PUBLIC)
  /// Argon2id hash of an optional private-room password.
  passwordHash     String?
  entryFee         Int            @default(0)
  maxPlayers       Int            @default(4)
  turnTimerSeconds Int            @default(30)
  status           RoomStatus     @default(WAITING)
  ruleConfigId     String?        @db.Uuid
  /// Idempotency key supplied by the creator to de-duplicate create requests.
  createRequestId  String?        @db.VarChar(128)
  expiresAt        DateTime?
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  host         User                   @relation("RoomHost", fields: [hostId], references: [id], onDelete: Restrict)
  ruleConfig   GameRuleConfiguration? @relation(fields: [ruleConfigId], references: [id], onDelete: Restrict)
  players      RoomPlayer[]
  matches      Match[]
  chatMessages ChatMessage[]
  reports      PlayerReport[]

  @@unique([hostId, createRequestId])
  @@index([status, visibility, createdAt])
  @@index([hostId])
  @@map("rooms")
}

/// Current seat occupancy. A row exists only while the player sits in an open room and is
/// deleted when they leave or the room closes. `userId` is unique, so a player can occupy
/// at most one seat across all rooms at any moment.
model RoomPlayer {
  id             String    @id @default(uuid()) @db.Uuid
  roomId         String    @db.Uuid
  userId         String    @unique @db.Uuid
  /// 0..3, enforced by CHECK constraint.
  seatIndex      Int
  isReady        Boolean   @default(false)
  disconnectedAt DateTime?
  joinedAt       DateTime  @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, seatIndex])
  @@map("room_players")
}

/// Quick-match queue, shared by every API instance. One row per searching player; `roomId`
/// is set when the player is matched, and the row is removed once they leave that room.
model MatchmakingEntry {
  userId    String   @id @db.Uuid
  entryFee  Int
  roomId    String?  @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryFee, roomId, createdAt])
  @@map("matchmaking_entries")
}

enum MatchStatus {
  CREATED
  DEALING
  PLAYING
  RESOLVING
  FINISHED
  ABORTED
}

model Match {
  id               String      @id @default(uuid()) @db.Uuid
  roomId           String      @db.Uuid
  status           MatchStatus @default(CREATED)
  entryFee         Int
  /// Immutable copy of the rules used for this match (validated by the shared rules schema).
  ruleSnapshot     Json
  /// Monotonic version of the authoritative game state; clients use it to detect staleness.
  stateVersion     Int         @default(0)
  /// Server-owned snapshot for crash recovery. Never sent to clients as-is (contains hands).
  stateSnapshot    Json?
  abortReason      String?     @db.VarChar(255)
  flaggedForReview Boolean     @default(false)
  startedAt        DateTime?
  finishedAt       DateTime?
  /// Set once inside the settlement transaction; guards against double settlement.
  settledAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  room               Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  players            MatchPlayer[]
  events             MatchEvent[]
  walletTransactions WalletTransaction[]
  reports            PlayerReport[]

  @@index([roomId])
  @@index([status, createdAt])
  @@index([finishedAt])
  @@map("matches")
}

enum MatchPlayerStatus {
  PLAYING
  FINISHED
  DISCONNECTED
  ABANDONED
}

model MatchPlayer {
  id             String            @id @default(uuid()) @db.Uuid
  matchId        String            @db.Uuid
  userId         String            @db.Uuid
  seatIndex      Int
  status         MatchPlayerStatus @default(PLAYING)
  /// 1 = first to empty their hand. Null until determined.
  placement      Int?
  cardsRemaining Int?
  /// Net coin change from this match (rewards minus entry fee); mirrors the ledger.
  coinDelta      Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([matchId, userId])
  @@unique([matchId, seatIndex])
  @@unique([matchId, placement])
  @@index([userId, createdAt(sort: Desc)])
  @@map("match_players")
}

enum MatchEventType {
  DEALT
  PLAY
  PASS
  TRICK_RESOLVED
  PLAYER_FINISHED
  TURN_TIMEOUT
  PLAYER_DISCONNECTED
  PLAYER_RECONNECTED
  MATCH_FINISHED
  MATCH_ABORTED
}

/// Ordered, append-only log of authoritative match actions (audit + replay + recovery).
model MatchEvent {
  id          String         @id @default(uuid()) @db.Uuid
  matchId     String         @db.Uuid
  sequence    Int
  type        MatchEventType
  actorUserId String?        @db.Uuid
  /// Client-supplied action ID for idempotency (unique per match when present).
  actionId    String?        @db.VarChar(64)
  payload     Json
  createdAt   DateTime       @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@unique([matchId, actionId])
  @@map("match_events")
}

// ─── Rewards & achievements ─────────────────────────────────────────────────

enum RewardType {
  DAILY_LOGIN
  FIRST_MATCH
  MISSION
  ACHIEVEMENT
}

model RewardClaim {
  id                  String     @id @default(uuid()) @db.Uuid
  userId              String     @db.Uuid
  rewardType          RewardType
  /// Reward period, e.g. "2026-10-26" (Asia/Ho_Chi_Minh day) or "mission:win-3:2026-W44".
  periodKey           String     @db.VarChar(64)
  amount              Int
  streakDay           Int?
  walletTransactionId String?    @unique @db.Uuid
  createdAt           DateTime   @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)

  @@unique([userId, rewardType, periodKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("reward_claims")
}

model Achievement {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(64)
  name         String   @db.VarChar(96)
  description  String   @db.VarChar(255)
  rewardAmount Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String   @db.Uuid
  achievementId String   @db.Uuid
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

// ─── Notifications, chat, moderation ────────────────────────────────────────

enum NotificationType {
  DAILY_REWARD
  MATCH_RESULT
  ROOM_INVITATION
  SECURITY
  ADMIN_NOTICE
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(120)
  body      String           @db.VarChar(500)
  data      Json?
  /// Prevents duplicate delivery of the same logical event (unique per user when present).
  dedupeKey String?          @db.VarChar(128)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model ChatMessage {
  id        String    @id @default(uuid()) @db.Uuid
  roomId    String    @db.Uuid
  userId    String    @db.Uuid
  /// Plain text only (rendered escaped); length limited by the application.
  content   String    @db.VarChar(500)
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

enum ReportReason {
  CHEATING
  COLLUSION
  ABUSIVE_CHAT
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model PlayerReport {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String       @db.Uuid
  roomId         String?      @db.Uuid
  matchId        String?      @db.Uuid
  reason         ReportReason
  details        String?      @db.VarChar(1000)
  status         ReportStatus @default(OPEN)
  resolvedById   String?      @db.Uuid
  resolutionNote String?      @db.VarChar(1000)
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedUser User   @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Restrict)
  resolvedBy   User?  @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  room         Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  match        Match? @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@map("player_reports")
}

// ─── Administration & configuration ─────────────────────────────────────────

/// Append-only record of sensitive administrative and security actions.
model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Null for actions performed by the system itself.
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(64)
  targetType String   @db.VarChar(32)
  targetId   String?  @db.VarChar(64)
  reason     String?  @db.VarChar(500)
  metadata   Json?
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Versioned game-rule presets. `rules` is validated against the shared rules schema;
/// matches copy the active preset into Match.ruleSnapshot at start.
model GameRuleConfiguration {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @db.VarChar(64)
  version           Int
  name              String   @db.VarChar(96)
  isActive          Boolean  @default(false)
  rules             Json
  allowedEntryFees  Int[]
  allowedTurnTimers Int[]
  createdById       String?  @db.Uuid
  createdAt         DateTime @default(now())

  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  rooms     Room[]

  @@unique([key, version])
  @@index([key, isActive])
  @@map("game_rule_configurations")
}

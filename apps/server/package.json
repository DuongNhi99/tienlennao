{
  "name": "@tienlen/server",
  "version": "0.1.0",
  "private": true,
  "description": "Tiến Lên Online backend (NestJS, REST + Socket.IO)",
  "scripts": {
    "build": "pnpm db:generate && nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:set-role": "dotenv -e ../../.env -- tsx prisma/set-role.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "~6.19.0",
    "@tienlen/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "^7.0.13",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "prisma": "~6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}

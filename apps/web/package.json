{
  "name": "@tienlen/web",
  "version": "0.1.0",
  "private": true,
  "description": "Tiến Lên Online web client (Next.js PWA)",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.105.0",
    "@tienlen/shared": "workspace:*",
    "lucide-react": "^1.61.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@next/env": "^16.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.1.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}

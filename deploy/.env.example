# Production settings, kept on the server as /opt/tienlen/.env (setup-server.sh creates it).
# Every line here is also passed to the API, so the API variables from the README
# (SMTP_URL, INITIAL_COIN_BONUS, SESSION_TTL_DAYS, …) can be set here too. Comment out a
# variable instead of leaving it empty.

# Public host name; its DNS A record must point at the server. Caddy gets the certificate.
APP_DOMAIN=tienlen.example
# Contact address for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=you@example.com
# Database password, letters and digits only (it is part of a URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Days to keep the daily database dumps in /opt/tienlen/backups.
BACKUP_KEEP_DAYS=14

# Email for account verification and password reset. Without it, production sends nothing.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Tiến Lên Online <no-reply@tienlen.example>

# Written by deploy.sh: the images of the running release.
# IMAGE_PREFIX=ghcr.io/owner/repo
# IMAGE_TAG=<commit sha>
